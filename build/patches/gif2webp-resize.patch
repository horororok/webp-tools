 //------------------------------------------------------------------------------
+// [webp-tools patch] Resize support.
 
+// Computes the output canvas size for a 'src_w' x 'src_h' GIF screen.
+// 'req_w' / 'req_h': requested size; 0 means unconstrained (keep aspect ratio).
+// 'fit_inside': treat the request as a bounding box and keep the aspect ratio,
+//   instead of stretching to exactly 'req_w' x 'req_h'.
+// 'down_only': never enlarge; leave the size untouched if any side would grow.
+// Returns 1 if the canvas must be rescaled (and sets *out_w / *out_h).
+static int ComputeResize(int src_w, int src_h, int req_w, int req_h,
+                         int fit_inside, int down_only,
+                         int* const out_w, int* const out_h) {
+  int w, h;
+  if (req_w <= 0 && req_h <= 0) return 0;
+  if (fit_inside || req_w <= 0 || req_h <= 0) {
+    const double sx = (req_w > 0) ? (double)req_w / src_w : 1e300;
+    const double sy = (req_h > 0) ? (double)req_h / src_h : 1e300;
+    const double s = (sx < sy) ? sx : sy;
+    w = (int)(src_w * s + 0.5);
+    h = (int)(src_h * s + 0.5);
+    if (w < 1) w = 1;
+    if (h < 1) h = 1;
+  } else {
+    w = req_w;
+    h = req_h;
+  }
+  if (down_only && (w > src_w || h > src_h)) return 0;
+  if (w == src_w && h == src_h) return 0;
+  *out_w = w;
+  *out_h = h;
+  return 1;
+}
